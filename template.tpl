___TESTS___

scenarios:
- name: Validates Authentication and Base HTTP Request
  code: |-
    let requestSent = false;
    mock('sendHttpRequest', (url, options, body) => {
      requestSent = true;
      assertThat(options.headers.Authorization).isEqualTo('Basic encoded_w_k:test-api-key');
      assertThat(options.headers['Content-Type']).isEqualTo('application/json; charset=utf-8');
      assertThat(body).isEqualTo('{}');
    });

    runCode(mockData);

    assertApi('gtmOnSuccess').wasCalled();
    assertThat(requestSent).isTrue();
- name: Correctly maps Data Tables to JSON Payload
  code: |-
    mockData.customParameterTable = [{key: 'client_id', value: '123'}];
    mockData.pageTable = [{key: 'path', value: '/home'}];
    mockData.eventTable = [{key: 'name', value: 'purchase'}];
    mockData.userTable = [{key: 'email', value: 'test@example.com'}];
    mockData.consentTable = [{key: 'analytics', value: 'granted'}];

    let capturedBody = '';
    mock('sendHttpRequest', (url, options, body) => {
      capturedBody = body;
    });

    runCode(mockData);
    let parsedPayload = JSON.parse(capturedBody);

    assertThat(parsedPayload.client_id).isEqualTo('123');
    assertThat(parsedPayload.page.path).isEqualTo('/home');
    assertThat(parsedPayload.event.name).isEqualTo('purchase');
    assertThat(parsedPayload.user.email).isEqualTo('test@example.com');
    assertThat(parsedPayload.consent.analytics).isEqualTo('granted');
- name: Filters out Empty Tables
  code: |-
    mockData.eventTable = [{key: 'name', value: 'login'}];

    let capturedBody = '';
    mock('sendHttpRequest', (url, options, body) => {
      capturedBody = body;
    });

    runCode(mockData);
    let parsedPayload = JSON.parse(capturedBody);

    assertThat(parsedPayload.event.name).isEqualTo('login');
    assertThat(parsedPayload.user).isUndefined();
    assertThat(parsedPayload.consent).isUndefined();
