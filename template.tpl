___SANDBOXED_JS_FOR_SERVER___

// --- Server-side GTM Tag Template: Zeotap Server2Server Realtime API Sender ---
// Description: This template sends an event payload to the Zeotap Server2Server Realtime API endpoint.
// It constructs a JSON payload from various user-configured data tables and
// includes a Base64 encoded authorization key.

// 1. Import Required APIs
// sendHttpRequest: Used to make asynchronous outbound HTTP requests.
// JSON: Provides methods for parsing and stringifying JSON data.
// Object: Provides methods for using an Object. 
// toBase64: Encodes string data into a Base64 format.
// logToConsole: Enables logging messages to the GTM server preview console for debugging.

const sendHttpRequest = require("sendHttpRequest");
const JSON = require("JSON");
const Object = require("Object"); 
const toBase64 = require("toBase64");
const logToConsole = require("logToConsole");

// 2. Configuration & Input Retrieval
// ZEOTAP_ENDPOINT: The fixed API endpoint for Zeotap.
// apiKey: The API key provided by the user in the template's configuration fields.
// Data Tables: Arrays of key-value pairs configured by the user, representing different
//              categories of event parameters (page, event, user, consent, custom).
//              Defaults to an empty array if not provided, preventing errors.

const ZEOTAP_ENDPOINT = "https://spl.zeotap.com/fp?region=EU&eventType=s2s";
const apiKey = data.apiKey;
const pageTable = data.pageTable || [];
const eventTable = data.eventTable || [];
const userTable = data.userTable || [];
const consentTable = data.consentTable || [];
const customParameterTable = data.customParameterTable || [];

// 3. Helper Function: Convert Table Array to Object
// This function transforms an array of objects (each with 'key' and 'value' properties)
// into a single flat JavaScript object. Only includes entries where 'key' and 'value' are defined.
const convertTableToObject = (tableArray) => {
  // Immediate exit for empty/missing inputs
  if (!tableArray || !tableArray.length) return undefined;

  const obj = {};
  let hasData = false;

  for (let i = 0; i < tableArray.length; i++) {
    const row = tableArray[i];
    // Check key/value existence. (row.key != null checks both null and undefined)
    if (row && row.key != null && row.value != null) {
      obj[row.key] = row.value;
      hasData = true;
    }
  }

  return hasData ? obj : undefined;
};

// 4. Prepare Authorization Key
// Constructs the Base64 encoded "writeKey" by prepending "w_k:" to the provided API key.
// This is used in the Authorization header for the HTTP request.
const writeKey = toBase64("w_k:" + apiKey);

// 5. Build Request Payload
// Initializes the main payload object. Dynamically adds converted data tables
// as nested objects (e.g., 'page', 'event') only if they contain data.
let payload = convertTableToObject(customParameterTable) || {}; 

const pageData = convertTableToObject(pageTable);
if (pageData) payload.page = pageData;

const eventData = convertTableToObject(eventTable);
if (eventData) payload.event = eventData;

const userData = convertTableToObject(userTable);
if (userData) payload.user = userData;

const consentData = convertTableToObject(consentTable);
if (consentData) payload.consent = consentData;

// Log the final payload for debugging purposes in the GTM preview console.
logToConsole("Final Zeotap Payload:", payload);

// 6. Send HTTP Request
// Initiates an asynchronous POST request to the Zeotap endpoint.
// The tag will be considered successful once this function call has executed without errors,
// regardless of the HTTP response status code.
sendHttpRequest(
  ZEOTAP_ENDPOINT,
  {
    headers: {
      "Content-Type": "application/json; charset=utf-8",
      "Authorization": "Basic " + writeKey
    },
    method: "POST",
    timeout: 500, // Milliseconds timeout for the request.
  },
  JSON.stringify(payload) // Converts the JavaScript 'payload' object into a JSON string for the request body.
  // No callback function, so no explicit success/failure handling from GTM's perspective.
);

// Call gtmOnSuccess() when Tag is fully loaded. 
data.gtmOnSuccess();


