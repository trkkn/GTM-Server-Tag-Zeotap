- name: Overwrites duplicate keys in the same table (Last Write Wins)
  code: |-
    mockData.eventTable = [
      {key: 'currency', value: 'USD'},
      {key: 'currency', value: 'EUR'} // Should overwrite USD
    ];

    let capturedBody = '';
    mock('sendHttpRequest', (url, options, body) => {
      capturedBody = body;
    });

    runCode(mockData);
    let parsedPayload = JSON.parse(capturedBody);

    assertThat(parsedPayload.event.currency).isEqualTo('EUR');
- name: Retains valid falsy values (0, false, empty strings)
  code: |-
    mockData.userTable = [
      {key: 'opted_in', value: false},
      {key: 'lifetime_value', value: 0},
      {key: 'middle_name', value: ''}
    ];

    let capturedBody = '';
    mock('sendHttpRequest', (url, options, body) => {
      capturedBody = body;
    });

    runCode(mockData);
    let parsedPayload = JSON.parse(capturedBody);

    assertThat(parsedPayload.user.opted_in).isFalse();
    assertThat(parsedPayload.user.lifetime_value).isEqualTo(0);
    assertThat(parsedPayload.user.middle_name).isEqualTo('');
- name: Omits the nested object if a table only contains invalid rows
  code: "mockData.pageTable = [\n  {key: null, value: '/home'}, \n  {key: 'url', value:\
    \ undefined}\n];\n\nlet capturedBody = '';\nmock('sendHttpRequest', (url, options,\
    \ body) => {\n  capturedBody = body;\n});\n\nrunCode(mockData);\nlet parsedPayload\
    \ = JSON.parse(capturedBody);\n\nassertThat(parsedPayload.page).isUndefined();"
- name: Initializes root payload correctly when custom parameters are missing
  code: |-
    // Simulate the user leaving the custom parameter table completely blank/undefined
    mockData.customParameterTable = undefined;
    mockData.eventTable = [{key: 'name', value: 'add_to_cart'}];

    let capturedBody = '';
    mock('sendHttpRequest', (url, options, body) => {
      capturedBody = body;
    });

    runCode(mockData);
    let parsedPayload = JSON.parse(capturedBody);

    assertThat(parsedPayload.event.name).isEqualTo('add_to_cart');

    const rootKeys = Object.keys(parsedPayload);
    assertThat(rootKeys.length).isEqualTo(1);
    assertThat(rootKeys[0]).isEqualTo('event');
- name: Gracefully handles a missing API Key
  code: |-
    // Simulate the user forgetting to input an API key
    mockData.apiKey = undefined;
    mockData.eventTable = [{key: 'name', value: 'test'}];

    let capturedAuthHeader = '';
    mock('sendHttpRequest', (url, options, body) => {
      capturedAuthHeader = options.headers.Authorization;
    });

    runCode(mockData);

    assertThat(capturedAuthHeader).isEqualTo('Basic encoded_w_k:undefined');
    assertApi('gtmOnSuccess').wasCalled();
setup: |-
  // 1. Require necessary modules
  const JSON = require('JSON');
  const Object = require('Object');

  // 2. Initialize the baseline mock data
  let mockData = {
    apiKey: 'test-api-key',
    customParameterTable: [],
    pageTable: [],
    eventTable: [],
    userTable: [],
    consentTable: []
  };

  // 3. Mock standard APIs
  // We make toBase64 predictable so we can assert the Authorization header accurately
  mock('toBase64', (str) => 'encoded_' + str);
  mock('logToConsole', () => {});


